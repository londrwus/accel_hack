# Vercel production env (set these in the Vercel project settings, then redeploy).
# Use the real backend on Modal instead of the bundled mocks.
VITE_USE_MOCKS=false
# Public URL of the Modal-hosted FastAPI app (backend/modal_web.py), no trailing slash.
VITE_API_BASE=https://hexagonterstretch--bellwether-web-web.modal.run
