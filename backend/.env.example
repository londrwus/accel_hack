# Copy these into the REPO-ROOT .env (C:\Users\Lenovo\Documents\accel_hack\.env), not this folder.
DEMO_MODE=replay            # replay | live (live needs ANTHROPIC_API_KEY, else it falls back to replay)
ANTHROPIC_API_KEY=
MODAL_TOKEN_ID=             # or leave empty: ~/.modal.toml from `modal token new` also works
MODAL_TOKEN_SECRET=
# Optional
# DEFAULT_FUND=localglobe
# REPLAY_SPEED=1            # default pace for POST /api/runs (override per call with ?speed=)
# MODAL_APP=bellwether
# MODAL_TIMEOUT_S=20        # Modal calls fall back to data/cache/modal/*.json, then offline data
# MODAL_SEARCH_TIMEOUT_S=5  # Startup Universe search by meaning (keyword search if slower)
# MODAL_DISABLED=1          # force the fallback (bad stage wifi)
# INVESTOR_INDEX_JSON=../data/investor_index.json   # decides "not enough history" for the backtest
# COMPANIES_CSV=../data/companies.csv
# BELLWETHER_DB=bellwether.db
